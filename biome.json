{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.presenter.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "jotai": "Presenter must be pure. Do not import jotai directly.",
                  "jotai-family": "Presenter must be pure. Do not import jotai-family."
                },
                "patterns": [
                  {
                    "group": [
                      "**/stores",
                      "**/stores/!(types)*",
                      "**/stores/index*"
                    ],
                    "message": "Presenter must not import stores/atoms directly. Pass state via props."
                  },
                  {
                    "group": ["**/logics/business/**", "**/logics/business"],
                    "message": "Presenter must not import business logic directly."
                  },
                  {
                    "group": [
                      "**/*.container",
                      "**/*.container.ts",
                      "**/*.container.tsx"
                    ],
                    "message": "Presenter must not import container hooks/components directly."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/*.container.ts", "**/*.container.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/logics/presentation/**",
                      "**/logics/presentation"
                    ],
                    "message": "Container must not import presentation logic."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
